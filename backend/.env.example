# Direct Supabase URL (no sslmode query param — prisma.ts configures SSL for pg v8+)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
PORT="3001"
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"
ADMIN_API_KEY="change-me"
# Text generation provider: "ollama" (self-hosted), "gemini" (Google AI Studio),
# or "openrouter" (OpenRouter API). Only the selected provider's credentials are required.
LLM_PROVIDER="gemini"

# Required when LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="mistral:7b-instruct"

# Required when LLM_PROVIDER="gemini". Everything else has a working default.
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-flash-lite-latest"
# "off" disables the thinkingConfig field entirely, for models that reject it.
GEMINI_THINKING_LEVEL="minimal"

# Required when LLM_PROVIDER="openrouter". OPENROUTER_MODEL is the full model
# slug from openrouter.ai/models, e.g. "google/gemma-3-27b-it:free".
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL=""

LLM_TIMEOUT_MS="40000"

# Scene narration rendered as centered italic blocks in the chat.
ROLEPLAY_ENABLED="true"
MAX_INPUT_CHARS="2000"
MAX_CONTEXT_MESSAGES="20"
RATE_LIMIT_MAX="60"
RATE_LIMIT_READ_MAX="120"
RATE_LIMIT_CHAT_MAX="20"
RATE_LIMIT_WINDOW="1 minute"
EXPO_ACCESS_TOKEN=""
PROACTIVE_TICK_MS="600000"
PROACTIVE_MATCH_DELAY_MS="1800000"
PROACTIVE_IDLE_MS="14400000"
PROACTIVE_DAILY_CAP="2"
PROACTIVE_BACKOFF_MS="86400000"
PROACTIVE_MAX_PER_TICK="10"

# Character image replies (feature-flagged; keep disabled until bucket + references exist)
IMAGE_REPLIES_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2-2026-04-21"
OPENAI_IMAGE_QUALITY="medium"
OPENAI_IMAGE_SIZE="1024x1536"
OPENAI_IMAGE_MODERATION="low"
OPENAI_IMAGE_TIMEOUT_MS="180000"
# Server-only Supabase secret key (service role); never ship to the app
SUPABASE_SECRET_KEY=""
SUPABASE_MEDIA_BUCKET="character-chat-media"
SIGNED_URL_TTL_SECONDS="3600"
IMAGE_DAILY_GENERATION_LIMIT="5"
IMAGE_CACHE_LIMIT_PER_CHARACTER="20"
IMAGE_WORKER_POLL_MS="5000"
IMAGE_WORKER_LEASE_MS="300000"
IMAGE_WORKER_MAX_ATTEMPTS="3"

# Fish Audio TTS (character voice replies). Free-tier model for development.
FISH_AUDIO_API_KEY=""
FISH_TTS_MODEL="s2.1-pro-free"
# Omit to auto-enable when FISH_AUDIO_API_KEY is set; "false" forces off.
# FISH_TTS_ENABLED="true"
FISH_TTS_MAX_CHARS="2000"
